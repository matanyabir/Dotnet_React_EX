<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests: real HTTP against the real pipeline via
    WebApplicationFactory, backed by a temp copy of the dataset.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.19" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\MX.Api\MX.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pristine dataset, copied per test into a temp file the API writes to. -->
    <Content Include="..\..\dataset.json" Link="TestData\dataset.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

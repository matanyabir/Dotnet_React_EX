{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Storage": {
    "DataFilePath": "Data/dataset.json",
    "UploadsDirectory": "wwwroot/uploads"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "Email": {
    // "Mock" logs the message and records it in memory — the README's simulated
    // sender, and the default so the app runs with no credentials at all.
    // Switch to "Smtp" and fill in Email:Smtp to deliver for real.
    "Provider": "Mock",
    "FromAddress": "support@example.com",
    "FromName": "MX Support",

    // Where the customer's tracking link points: the frontend, not the API.
    "FrontendBaseUrl": "http://localhost:5173",

    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseStartTls": true,
      // Supply these through user-secrets, never here. For Gmail the password is
      // an app password, not the account password:
      //   dotnet user-secrets set "Email:Smtp:Username" "you@gmail.com"
      //   dotnet user-secrets set "Email:Smtp:Password" "<16-char app password>"
      "Username": "",
      "Password": ""
    }
  },

  "Auth": {
    "Jwt": {
      // No signing key here on purpose. Anyone holding it can mint admin tokens,
      // so it must come from appsettings.Development.json, user-secrets, or an
      // environment variable. Startup fails with a clear message if it is absent.
      "SigningKey": "",
      "Issuer": "mx-support-api",
      "Audience": "mx-support-frontend",
      "ExpiryMinutes": 60
    },

    // Accounts live in the environment-specific files for the same reason.
    "Users": []
  }
}

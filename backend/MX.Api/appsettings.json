{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Storage": {
    "DataFilePath": "Data/dataset.json",
    "UploadsDirectory": "wwwroot/uploads"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "Ai": {
    // "Stub" summarises locally with no network, key, or cost — the default, so
    // the feature works immediately after a clone. "Claude" calls the real API;
    // "None" switches summaries off entirely.
    "Provider": "Stub",

    // Supply through user-secrets, never here:
    //   dotnet user-secrets set "Ai:ApiKey" "sk-ant-..."
    "ApiKey": "",

    "Model": "claude-opus-5",

    // Short by design: a customer filing a ticket must never wait on the AI.
    // Exceeding it costs the summary and nothing else.
    "TimeoutSeconds": 10,
    "MaxSummaryLength": 200
  },

  "Email": {
    // "Mock" logs the message and records it in memory — the README's simulated
    // sender, and the default so the app runs with no credentials at all.
    // Switch to "Smtp" and fill in Email:Smtp to deliver for real.
    "Provider": "Mock",
    "FromAddress": "support@example.com",
    "FromName": "MX Support",

    // Where the customer's tracking link points: the frontend, not the API.
    "FrontendBaseUrl": "http://localhost:5173",

    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseStartTls": true,
      // Supply these through user-secrets, never here. For Gmail the password is
      // an app password, not the account password:
      //   dotnet user-secrets set "Email:Smtp:Username" "you@gmail.com"
      //   dotnet user-secrets set "Email:Smtp:Password" "<16-char app password>"
      "Username": "",
      "Password": ""
    }
  },

  "Auth": {
    "Jwt": {
      // No signing key here on purpose. Anyone holding it can mint admin tokens,
      // so it must come from appsettings.Development.json, user-secrets, or an
      // environment variable. Startup fails with a clear message if it is absent.
      "SigningKey": "",
      "Issuer": "mx-support-api",
      "Audience": "mx-support-frontend",
      "ExpiryMinutes": 60
    },

    // Guessing is the attack sign-in is actually exposed to, so the door has a
    // cap the rest of the API does not need. Counted per client address over a
    // five-minute window: room enough for someone who has forgotten which
    // password they used, nowhere near enough to work through a word list.
    "LoginRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 300
    },

    // Accounts live in the environment-specific files for the same reason.
    "Users": []
  }
}

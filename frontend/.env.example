# Where the ASP.NET Core API is listening. Matches the `http` launch profile in
# backend/MX.Api/Properties/launchSettings.json.
#
# Optional — src/api/client.ts falls back to this exact value, so the app works
# with no .env at all. Copy this file to `.env` only if you move the API.
VITE_API_BASE_URL=http://localhost:5099
